<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true"
            fx:controller="com.tdsi.memotheque.controller.DetailMemoireController">

    <content>
        <VBox spacing="15" styleClass="page">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>

            <Label text="FICHE DÉTAILLÉE DU MÉMOIRE"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <Separator/>

            <Label fx:id="labelTitre" text="Titre du mémoire"
                   wrapText="true"
                   style="-fx-font-size: 19px; -fx-font-weight: bold;"/>

            <Label fx:id="labelSignature" wrapText="true" maxWidth="Infinity"/>

            <Label text="Informations générales"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <HBox spacing="10">
                <Label text="Auteur :" minWidth="120"/>
                <Label fx:id="labelAuteur" text="-"
                       wrapText="true"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Co-auteur :" minWidth="120"/>
                <Label fx:id="labelCoAuteur" text="-"
                       wrapText="true"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Domaine :" minWidth="120"/>
                <Label fx:id="labelDomaine" text="-"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Niveau :" minWidth="120"/>
                <Label fx:id="labelNiveau" text="-"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Année académique :" minWidth="120"/>
                <Label fx:id="labelAnnee" text="-"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Encadreur :" minWidth="120"/>
                <Label fx:id="labelEncadreur" text="-"
                       wrapText="true"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Date de soutenance :" minWidth="120"/>
                <Label fx:id="labelDateSoutenance" text="-"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Mention :" minWidth="120"/>
                <Label fx:id="labelMention" text="-"/>
            </HBox>

            <HBox spacing="10">
                <Label text="Date de publication :" minWidth="120"/>
                <Label fx:id="labelDatePublication" text="-"/>
            </HBox>

            <Separator/>

            <Label text="Résumé"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <TextArea fx:id="zoneResume"
                      editable="false"
                      wrapText="true"
                      prefRowCount="5"/>

            <Label text="Mots-clés"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

            <Label fx:id="labelMotsCles" text="-"
                   wrapText="true"/>

            <Separator/>

            <HBox spacing="25">
                <Label fx:id="labelVues" text="Vues : 0"/>
                <Label fx:id="labelTelechargements"
                       text="Téléchargements : 0"/>
            </HBox>

           <HBox spacing="12">
    <Button text="Retour à la recherche"
            onAction="#retourRecherche"/>

    <Button fx:id="boutonOuvrir"
            text="Ouvrir le PDF"
            onAction="#ouvrirPdf"/>

    <Button fx:id="boutonEnregistrer"
            text="Enregistrer sous..."
            onAction="#enregistrerSous"/>

    <Button text="Citer ce mémoire"
            onAction="#citer"/>
</HBox>

            <Label fx:id="labelMessage"
                   wrapText="true"
                   style="-fx-text-fill: #b42318;"/>
        </VBox>
    </content>
</ScrollPane>
