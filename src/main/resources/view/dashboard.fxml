<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- [M5] Tableau de bord -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tdsi.memotheque.controller.DashboardController"
            fitToWidth="true">
  <content>
    <VBox spacing="16" styleClass="page">
      <padding>
        <Insets top="22" right="25" bottom="20" left="25"/>
      </padding>

      <Label text="Tableau de bord" styleClass="titre-page"/>

      <!-- Bannière d'accueil sur l'illustration du campus -->
      <StackPane fx:id="bandeauAccueil" styleClass="bandeau-accueil">
        <VBox styleClass="bandeau-accueil-voile" alignment="CENTER_LEFT">
          <Label fx:id="labelBonjour" text="Bonjour" styleClass="bonjour"/>
          <Label fx:id="labelSousBonjour" styleClass="bonjour-sous" wrapText="true" maxWidth="560"/>
        </VBox>
      </StackPane>

      <HBox spacing="16">
        <HBox styleClass="carte-stat" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
          <StackPane fx:id="iconePublies" styleClass="pastille-icone, vert"/>
          <VBox>
            <Label text="Mémoires publiés" styleClass="carte-stat-titre"/>
            <Label fx:id="labelTotalValides" text="0" styleClass="carte-stat-valeur"/>
          </VBox>
        </HBox>
        <HBox styleClass="carte-stat" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
          <StackPane fx:id="iconeEtudiants" styleClass="pastille-icone"/>
          <VBox>
            <Label text="Étudiants inscrits" styleClass="carte-stat-titre"/>
            <Label fx:id="labelTotalEtudiants" text="0" styleClass="carte-stat-valeur"/>
          </VBox>
        </HBox>
        <HBox styleClass="carte-stat" spacing="14" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
          <StackPane fx:id="iconeAttente" styleClass="pastille-icone, or"/>
          <VBox>
            <Label text="En attente de l'avis encadreur" styleClass="carte-stat-titre"/>
            <Label fx:id="labelEnAttente" text="0" styleClass="carte-stat-valeur"/>
          </VBox>
        </HBox>
      </HBox>

      <!-- À faire selon le rôle + prochaines soutenances (rempli par le contrôleur) -->
      <VBox fx:id="blocAFaire" spacing="8" styleClass="carte">
        <Label text="À faire" styleClass="sous-titre"/>
      </VBox>

      <HBox spacing="16">
        <PieChart fx:id="graphiqueDomaines" title="Mémoires publiés par domaine"
                  legendVisible="true" labelsVisible="false" legendSide="BOTTOM"
                  prefHeight="300" HBox.hgrow="ALWAYS" animated="false"/>
        <BarChart fx:id="graphiqueAnnees" title="Mémoires publiés par année"
                  legendVisible="false" prefHeight="300" HBox.hgrow="ALWAYS" animated="false">
          <xAxis>
            <CategoryAxis label="Année académique" animated="false"/>
          </xAxis>
          <yAxis>
            <NumberAxis fx:id="axeNombre" label="Nombre" minorTickVisible="false" animated="false"
                        autoRanging="false" lowerBound="0" upperBound="5" tickUnit="1"/>
          </yAxis>
        </BarChart>
      </HBox>

      <Label text="Les 5 mémoires les plus consultés" styleClass="sous-titre"/>
      <TableView fx:id="tableTop" prefHeight="190">
        <columnResizePolicy>
          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <columns>
          <TableColumn fx:id="colTitre" text="Titre" prefWidth="380"/>
          <TableColumn fx:id="colDomaine" text="Domaine" prefWidth="200"/>
          <TableColumn fx:id="colVues" text="Vues" prefWidth="80"/>
          <TableColumn fx:id="colTelechargements" text="Téléchargements" prefWidth="120"/>
        </columns>
        <placeholder>
          <Label text="Aucun mémoire publié pour le moment."/>
        </placeholder>
      </TableView>

      <Label fx:id="labelMessage" wrapText="true" styleClass="message-erreur"/>
    </VBox>
  </content>
</ScrollPane>
