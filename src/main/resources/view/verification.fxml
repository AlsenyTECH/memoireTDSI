<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Vérification de l'authenticité d'un document officiel (QR code ou code imprimé), avec ou sans compte -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tdsi.memotheque.controller.VerificationController" fitToWidth="true">
  <content>
    <VBox spacing="16" styleClass="page">
      <padding>
        <Insets top="22" right="30" bottom="22" left="30"/>
      </padding>

      <HBox fx:id="barreRetour" spacing="10" alignment="CENTER_LEFT" visible="false" managed="false">
        <Button text="← Retour à la connexion" onAction="#retour"/>
      </HBox>
      <Label text="Vérifier un document" styleClass="titre-page"/>
      <Label wrapText="true" styleClass="aide" minHeight="-Infinity"
             text="Convocations, procès-verbaux et attestations portent un QR code signé par la clé Ed25519 de l'établissement. Scannez-le avec un téléphone puis collez le texte obtenu ci-dessous, ou saisissez le code de 16 caractères imprimé à côté (ex. K7F2-9QXA-3MTP-W8LD)."/>

      <VBox styleClass="carte" spacing="10">
        <Label text="Texte du QR code ou code de vérification" styleClass="sous-titre"/>
        <TextArea fx:id="zoneSaisie" prefRowCount="3" wrapText="true"
                  promptText="MTDSI1|… (texte du QR code)   ou   K7F2-9QXA-3MTP-W8LD"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
          <Button fx:id="boutonVerifier" text="Vérifier" onAction="#verifier" styleClass="bouton-principal" defaultButton="true"/>
          <Button text="Coller" onAction="#coller"/>
          <Button text="Effacer" onAction="#effacer"/>
        </HBox>
      </VBox>

      <VBox fx:id="carteResultat" styleClass="carte" spacing="12" visible="false" managed="false">
        <HBox spacing="14" alignment="CENTER_LEFT">
          <Label fx:id="labelEtat" styleClass="pastille"/>
          <Label fx:id="labelType" styleClass="sous-titre"/>
        </HBox>
        <Label fx:id="labelMessage" wrapText="true" minHeight="-Infinity"/>
        <GridPane fx:id="grilleChamps" hgap="18" vgap="8"/>
        <Label fx:id="labelEmission" styleClass="aide" wrapText="true" minHeight="-Infinity"/>
      </VBox>

      <TitledPane text="Vérification hors ligne : clé publique de l'établissement" expanded="false">
        <VBox spacing="8">
          <Label wrapText="true" styleClass="aide" minHeight="-Infinity"
                 text="Le QR code contient les informations du document et leur signature Ed25519 (préfixe de domaine « MemoTDSI-document-v1 »). Avec cette clé publique (X.509, Base64), n'importe quel outil cryptographique peut vérifier un document sans accéder à MémoTDSI."/>
          <TextArea fx:id="zoneCle" editable="false" prefRowCount="2" wrapText="true"/>
          <Label fx:id="labelEmpreinte" styleClass="aide"/>
        </VBox>
      </TitledPane>
    </VBox>
  </content>
</ScrollPane>
