<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Paramètres de la scolarité : année en cours et campagne de dépôt par niveau -->
<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tdsi.memotheque.controller.ParametresController" fitToWidth="true">
  <content>
    <VBox spacing="16" styleClass="page">
      <padding>
        <Insets top="22" right="30" bottom="22" left="30"/>
      </padding>

      <Label text="Campagne de dépôt" styleClass="titre-page"/>
      <Label wrapText="true" styleClass="aide" minHeight="-Infinity"
             text="L'année académique est imposée à tous les dépôts. Chaque niveau a sa propre campagne : ouvrez-la, fixez sa date limite, puis prolongez-la ou écourtez-la au besoin. Les étudiants du niveau sont prévenus à chaque changement."/>

      <VBox styleClass="carte" spacing="10">
        <Label text="Année académique en cours" styleClass="sous-titre"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
          <TextField fx:id="champAnnee" promptText="ex. 2026-2027" prefWidth="200"/>
          <Button text="Année d'aujourd'hui" onAction="#proposerAnnee"/>
        </HBox>
      </VBox>

      <VBox styleClass="carte" spacing="12">
        <Label text="Dépôts par niveau" styleClass="sous-titre"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
          <Label text="Pour tous les niveaux :" styleClass="aide"/>
          <Button text="Tout ouvrir" onAction="#toutOuvrir"/>
          <Button text="Tout fermer" onAction="#toutFermer"/>
          <Button text="Même date limite partout..." onAction="#memeDate"/>
        </HBox>
        <GridPane fx:id="grilleNiveaux" hgap="14" vgap="10"/>
      </VBox>

      <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="boutonEnregistrer" text="Enregistrer" onAction="#enregistrer" styleClass="bouton-principal"/>
        <Button text="Annuler les modifications" onAction="#recharger"/>
      </HBox>

      <Label fx:id="labelMessage" wrapText="true" styleClass="info" minHeight="-Infinity"/>
    </VBox>
  </content>
</ScrollPane>
