<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Paramètres de la scolarité : année en cours et campagne de dépôt -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tdsi.memotheque.controller.ParametresController"
      spacing="14" styleClass="page">
  <padding>
    <Insets top="22" right="30" bottom="22" left="30"/>
  </padding>

  <Label text="Campagne de dépôt" styleClass="titre-page"/>
  <Label wrapText="true" styleClass="aide" minHeight="-Infinity"
         text="L'année académique est imposée à tous les dépôts : l'étudiant ne la choisit pas. Fermez la campagne ou fixez une date limite pour arrêter les dépôts."/>
  <Label fx:id="labelEtat" wrapText="true" styleClass="info"/>

  <GridPane hgap="12" vgap="12" maxWidth="560">
    <columnConstraints>
      <ColumnConstraints minWidth="170"/>
      <ColumnConstraints hgrow="ALWAYS"/>
    </columnConstraints>

    <Label text="Année académique en cours" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <HBox spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1">
      <TextField fx:id="champAnnee" promptText="ex. 2026-2027" HBox.hgrow="ALWAYS"/>
      <Button text="Année d'aujourd'hui" onAction="#proposerAnnee"/>
    </HBox>

    <Label text="Dépôts" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <CheckBox fx:id="caseOuverte" text="Campagne ouverte" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="Date limite de dépôt" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <DatePicker fx:id="dateLimite" promptText="Aucune" maxWidth="Infinity"
                GridPane.rowIndex="2" GridPane.columnIndex="1"/>
  </GridPane>

  <HBox spacing="10">
    <Button text="Enregistrer" onAction="#enregistrer" styleClass="bouton-principal"/>
  </HBox>

  <Label fx:id="labelMessage" wrapText="true" styleClass="message-erreur"/>
</VBox>
