<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<!-- [M2] Écran de connexion -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tdsi.memotheque.controller.LoginController"
      alignment="CENTER" spacing="12" prefWidth="480" prefHeight="420" styleClass="page">
  <padding>
    <Insets top="30" right="50" bottom="30" left="50"/>
  </padding>
  <Label text="MémoTDSI" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
  <Label text="Connexion"/>
  <TextField fx:id="champIdentifiant" promptText="Email ou matricule" onAction="#seConnecter"/>
  <PasswordField fx:id="champMotDePasse" promptText="Mot de passe" onAction="#seConnecter"/>
  <Button text="Se connecter" maxWidth="Infinity" defaultButton="true" onAction="#seConnecter"
          styleClass="bouton-principal"/>
  <Label fx:id="labelMessage" wrapText="true" styleClass="message-erreur"/>
  <Hyperlink text="Pas encore de compte ? S'inscrire (tdsien)" onAction="#allerInscription"/>
</VBox>
