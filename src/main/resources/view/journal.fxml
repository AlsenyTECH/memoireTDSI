<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- [M6] (Admin) Journal d'activité -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tdsi.memotheque.controller.JournalController"
      spacing="12" styleClass="page">
  <padding>
    <Insets top="22" right="25" bottom="20" left="25"/>
  </padding>

  <Label text="Journal d'activité" styleClass="titre-page"/>

  <HBox spacing="10">
    <TextField fx:id="champFiltre" promptText="Filtrer (action, utilisateur, détail)" HBox.hgrow="ALWAYS"/>
    <Button text="Actualiser" onAction="#actualiser"/>
    <Button text="Vérifier l'intégrité" onAction="#verifierIntegrite" styleClass="bouton-principal"/>
    <Button text="Exporter en CSV" onAction="#exporterCsv"/>
  </HBox>

  <Label fx:id="labelIntegrite" wrapText="true" visible="false" managed="false"/>

  <TableView fx:id="tableJournal" VBox.vgrow="ALWAYS">
    <columnResizePolicy>
      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
    </columnResizePolicy>
    <columns>
      <TableColumn fx:id="colDate" text="Date et heure" prefWidth="150"/>
      <TableColumn fx:id="colUtilisateur" text="Utilisateur" prefWidth="230"/>
      <TableColumn fx:id="colAction" text="Action" prefWidth="170"/>
      <TableColumn fx:id="colDetails" text="Détails" prefWidth="330"/>
    </columns>
    <placeholder>
      <Label text="Le journal est vide."/>
    </placeholder>
  </TableView>

  <Label fx:id="labelMessage" wrapText="true"/>
</VBox>
