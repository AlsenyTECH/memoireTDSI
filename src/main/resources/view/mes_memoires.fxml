<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- [M3] Mes mémoires -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tdsi.memotheque.controller.MesMemoiresController"
      spacing="12" styleClass="page">
  <padding>
    <Insets top="22" right="25" bottom="20" left="25"/>
  </padding>

  <Label text="Mes mémoires" styleClass="titre-page"/>
  <Label text="Circuit : dépôt → avis de l'encadreur → soutenance programmée par la scolarité → procès-verbal du jury → publication. Un mémoire peut être modifié tant que la soutenance n'est pas autorisée." wrapText="true"/>

  <TableView fx:id="tableMemoires" VBox.vgrow="ALWAYS">
    <columnResizePolicy>
      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
    </columnResizePolicy>
    <columns>
      <TableColumn fx:id="colTitre" text="Titre" prefWidth="200"/>
      <TableColumn fx:id="colNiveau" text="Niveau / année" prefWidth="110"/>
      <TableColumn fx:id="colStatut" text="État" prefWidth="130"/>
      <TableColumn fx:id="colSoutenance" text="Soutenance" prefWidth="190"/>
      <TableColumn fx:id="colResultat" text="Résultat" prefWidth="130"/>
      <TableColumn fx:id="colSuivi" text="Prochaine étape" prefWidth="240"/>
    </columns>
    <placeholder>
      <Label text="Aucun mémoire déposé."/>
    </placeholder>
  </TableView>

  <HBox spacing="10">
    <Button text="Déposer un mémoire" onAction="#nouveauDepot" styleClass="bouton-principal"/>
    <Button fx:id="boutonDetail" text="Voir le détail" onAction="#voirDetail"/>
    <Button fx:id="boutonHistorique" text="Historique des versions" onAction="#voirHistorique"/>
    <Button fx:id="boutonAttestation" text="Attestation de dépôt" onAction="#imprimerAttestation"/>
    <Button fx:id="boutonModifier" text="Modifier" onAction="#modifier"/>
    <Button fx:id="boutonSupprimer" text="Supprimer" onAction="#supprimer" styleClass="bouton-danger"/>
  </HBox>

  <Label fx:id="labelMessage" wrapText="true" styleClass="message-erreur"/>
</VBox>
