<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- [M6] (Admin) Comptes : étudiants, enseignants, personnel administratif -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tdsi.memotheque.controller.ComptesController"
      spacing="14" styleClass="page">
  <padding>
    <Insets top="22" right="25" bottom="20" left="25"/>
  </padding>

  <Label text="Gestion des comptes" styleClass="titre-page"/>

  <HBox spacing="10" alignment="CENTER_LEFT">
    <Label text="Étudiants, enseignants et personnel administratif. Créez un compte ou importez un fichier Excel : chaque personne reçoit un mot de passe temporaire à changer à la première connexion."
           wrapText="true" styleClass="aide" HBox.hgrow="ALWAYS" maxWidth="Infinity" minHeight="-Infinity"/>
    <Button fx:id="boutonNouveau" text="Nouveau compte" onAction="#nouveauCompte" styleClass="bouton-principal" minWidth="-Infinity"/>
    <Button fx:id="boutonImporter" text="Importer un fichier Excel..." onAction="#importer" minWidth="-Infinity"/>
  </HBox>

  <HBox spacing="8" alignment="CENTER_LEFT">
    <ToggleButton fx:id="ongletTous" text="Tous" styleClass="onglet" selected="true"/>
    <ToggleButton fx:id="ongletEtudiants" text="Étudiants" styleClass="onglet"/>
    <ToggleButton fx:id="ongletEnseignants" text="Enseignants" styleClass="onglet"/>
    <ToggleButton fx:id="ongletAdministratifs" text="Personnel administratif" styleClass="onglet"/>
    <Region HBox.hgrow="ALWAYS"/>
    <TextField fx:id="champRecherche" promptText="Rechercher (nom, e-mail, téléphone, n° de carte)" prefWidth="380"/>
  </HBox>
  <CheckBox fx:id="caseInactifs" text="Afficher seulement les comptes inactifs ou verrouillés"/>

  <TableView fx:id="tableComptes" VBox.vgrow="ALWAYS">
    <columnResizePolicy>
      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
    </columnResizePolicy>
    <columns>
      <TableColumn fx:id="colNom" text="Nom" prefWidth="180"/>
      <TableColumn fx:id="colEmail" text="E-mail" prefWidth="220"/>
      <TableColumn fx:id="colTelephone" text="Téléphone" prefWidth="160"/>
      <TableColumn fx:id="colMatricule" text="N° carte" prefWidth="130"/>
      <TableColumn fx:id="colRole" text="Type" prefWidth="160"/>
      <TableColumn fx:id="colNiveau" text="Niveau" prefWidth="70"/>
      <TableColumn fx:id="colActif" text="État" prefWidth="110"/>
    </columns>
    <placeholder>
      <Label text="Aucun compte pour ce filtre."/>
    </placeholder>
  </TableView>

  <HBox spacing="10">
    <Button fx:id="boutonActiver" text="Activer" onAction="#activer" styleClass="bouton-succes"/>
    <Button fx:id="boutonDesactiver" text="Désactiver" onAction="#desactiver" styleClass="bouton-danger"/>
    <Button fx:id="boutonDeverrouiller" text="Déverrouiller" onAction="#deverrouiller"/>
    <Button fx:id="boutonReinitialiser" text="Réinitialiser le mot de passe" onAction="#reinitialiser"/>
    <Button fx:id="boutonRetirer2fa" text="Retirer la double authentification" onAction="#retirerDoubleFacteur"/>
  </HBox>

  <Label fx:id="labelMessage" wrapText="true" styleClass="info"/>
</VBox>
